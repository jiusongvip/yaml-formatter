---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  slug: string;
  faqs?: { question: string; answer: string }[];
}

const { title, description, slug, faqs = [] } = Astro.props;
const canonicalUrl = `https://yaml-formatter.com/blog/${slug}`;

const blogPosts = [
  { slug: 'yaml-syntax-guide', title: 'YAML Syntax Guide' },
  { slug: 'yaml-common-errors', title: '7 Common YAML Errors' },
  { slug: 'yaml-vs-json-vs-toml', title: 'YAML vs JSON vs TOML' },
];
const relatedPosts = blogPosts.filter(p => p.slug !== slug);

const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  url: canonicalUrl,
  image: 'https://yaml-formatter.com/og-image.png',
  author: { '@type': 'Organization', name: 'YAML Formatter' },
  publisher: { '@type': 'Organization', name: 'YAML Formatter', url: 'https://yaml-formatter.com' },
  datePublished: '2025-01-15',
  dateModified: '2026-08-10',
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://yaml-formatter.com' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://yaml-formatter.com/#guides' },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};

const faqLd = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
} : null;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8Y4ZM0KXRH"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-8Y4ZM0KXRH');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="YAML Formatter" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://yaml-formatter.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://yaml-formatter.com/og-image.png" />
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </head>
  <body class="bg-white text-zinc-800 antialiased">
    <header class="site-header">
      <nav class="container-tool flex items-center justify-between h-[64px]">
        <a href="/" class="flex items-center gap-2.5 no-underline" aria-label="YAML Formatter home">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-blue-600 text-white text-sm font-bold">Y</span>
          <span class="font-semibold text-[15px] tracking-tight text-zinc-900">YAML Formatter</span>
        </a>
        <div class="flex items-center gap-6">
          <a href="/#formatter" class="nav-link">Tool</a>
          <a href="/#guides" class="nav-link">Guides</a>
        </div>
      </nav>
    </header>
    <main class="container-narrow py-14">
      <article class="article max-w-none">
        <header class="mb-10">
          <nav class="flex items-center gap-2 text-sm text-zinc-400 mb-6">
            <a href="/" class="text-zinc-500 hover:text-zinc-900">Home</a>
            <span>/</span>
            <a href="/#guides" class="text-zinc-500 hover:text-zinc-900">Guides</a>
            <span>/</span>
            <slot name="breadcrumb" />
          </nav>
          <slot name="title" />
        </header>
        <slot />
      </article>
      <footer class="mt-16 pt-8 border-t border-zinc-200">
        <div class="mb-8">
          <p class="text-sm font-semibold text-zinc-900 mb-4">Related articles</p>
          <ul class="flex flex-col gap-2">
            {relatedPosts.map(post => (
              <li>
                <a href={`/blog/${post.slug}`} class="text-sm text-blue-600 hover:text-blue-700 hover:underline underline-offset-4">{post.title}</a>
              </li>
            ))}
          </ul>
        </div>
        <p class="text-sm text-zinc-500">
          Try our <a href="/#formatter" class="text-blue-600 hover:text-blue-700 hover:underline underline-offset-4">free online YAML formatter</a> - runs entirely in your browser.
        </p>
      </footer>
    </main>
  </body>
</html>