---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  slug: string;
  faqs?: { question: string; answer: string }[];
}

const { title, description, slug, faqs = [] } = Astro.props;
const canonicalUrl = `https://yaml-formatter.com/blog/${slug}`;

const blogPosts = [
  { slug: 'yaml-syntax-guide', title: 'YAML Syntax Guide' },
  { slug: 'yaml-common-errors', title: '7 Common YAML Errors' },
  { slug: 'yaml-vs-json-vs-toml', title: 'YAML vs JSON vs TOML' },
];
const relatedPosts = blogPosts.filter(p => p.slug !== slug);

const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  url: canonicalUrl,
  image: 'https://yaml-formatter.com/og-image.svg',
  author: { '@type': 'Organization', name: 'YAML Formatter' },
  publisher: { '@type': 'Organization', name: 'YAML Formatter', url: 'https://yaml-formatter.com' },
  datePublished: '2025-01-15',
  dateModified: '2025-08-10',
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://yaml-formatter.com' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://yaml-formatter.com/blog' },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};

const faqLd = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
} : null;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content="https://yaml-formatter.com/og-image.svg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
    <script is:inline>
      (()=>{const t=localStorage.getItem("theme");const d=t||(window.matchMedia("(prefers-color-scheme:dark)").matches?"dark":"light");document.documentElement.classList.add(d)})();
    </script>
  </head>
  <body class="bg-white text-zinc-900 dark:bg-zinc-950 dark:text-zinc-100 font-sans antialiased">
    <header class="sticky top-0 z-50 border-b border-zinc-200/60 dark:border-zinc-800/60 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md">
      <nav class="max-w-4xl mx-auto flex items-center justify-between h-14 px-4 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-2.5 group">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-emerald-600 text-white font-bold text-sm group-hover:bg-emerald-700 transition-colors">Y</span>
          <span class="font-semibold text-base tracking-tight text-zinc-900 dark:text-zinc-100">YAML Formatter</span>
        </a>
        <div class="flex items-center gap-4">
          <a href="/#formatter" class="text-sm text-zinc-500 dark:text-zinc-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Tool</a>
          <a href="/blog/yaml-syntax-guide" class="text-sm text-zinc-500 dark:text-zinc-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Blog</a>
          <button id="blog-theme-toggle" class="p-2 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100" aria-label="Toggle theme">
            <svg id="blog-sun-icon" class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            <svg id="blog-moon-icon" class="w-4 h-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
        </div>
      </nav>
    </header>
    <script is:inline>
      const tbtn = document.getElementById("blog-theme-toggle");
      tbtn && tbtn.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });
    </script>
    <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <article class="prose prose-zinc dark:prose-invert max-w-none">
        <header class="mb-10">
          <nav class="flex items-center gap-2 text-sm text-zinc-400 dark:text-zinc-500 mb-6">
            <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
            <span>/</span>
            <span class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Blog</span>
            <span>/</span>
            <slot name="breadcrumb" />
          </nav>
          <slot name="title" />
        </header>
        <slot />
      </article>
      <footer class="mt-16 pt-8 border-t border-zinc-200 dark:border-zinc-800">
        <div class="mb-8">
          <h3 class="text-sm font-semibold text-zinc-700 dark:text-zinc-300 mb-3">Related Articles</h3>
          <ul class="flex flex-col gap-2">
            {relatedPosts.map(post => (
              <li>
                <a href={`/blog/${post.slug}`} class="text-sm text-emerald-600 dark:text-emerald-400 hover:underline">{post.title}</a>
              </li>
            ))}
          </ul>
        </div>
        <p class="text-sm text-zinc-400 dark:text-zinc-500">
          Try our <a href="/#formatter" class="text-emerald-600 dark:text-emerald-400 hover:underline">free online YAML formatter</a> - runs entirely in your browser.
        </p>
      </footer>
    </main>
  </body>
</html>
