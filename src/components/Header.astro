---
const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Formatter' },
  { href: '/yaml-to-json', label: 'YAML to JSON' },
  { href: '/json-to-yaml', label: 'JSON to YAML' },
  { href: '/case-converter', label: 'Case Converter' },
  { href: '/blog', label: 'Blog' },
];
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class="site-header">
  <nav class="container-tool flex items-center justify-between h-[64px]">
    <a href="/" class="flex items-center gap-2.5 no-underline" aria-label="YAML Formatter home">
      <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-blue-600 text-white text-sm font-bold">Y</span>
      <span class="font-semibold text-[15px] tracking-tight text-zinc-900">YAML Formatter</span>
    </a>

    <div class="hidden lg:flex items-center gap-6">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={['nav-link', { active: isActive(l.href) }]}
        >
          {l.label}
        </a>
      ))}
    </div>

    <a
      href="https://github.com/jiusongvip/yaml-formatter"
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg border border-zinc-200 text-sm font-medium text-zinc-700 hover:bg-zinc-50 hover:text-zinc-900 no-underline"
      aria-label="GitHub"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
      <span class="hidden sm:inline">GitHub</span>
    </a>
  </nav>
</header>