---
---
<section id="faq" class="section">
  <div class="container-tool max-w-3xl">
    <h2 class="h-section text-center mb-10">Frequently asked questions</h2>
    <dl class="space-y-3">
      {[
        { q: 'Is my YAML data safe? Does it get uploaded?', a: 'No. Everything runs entirely in your browser using client-side JavaScript. Your data is never transmitted to any server — disconnect from the internet after loading and it keeps working.' },
        { q: 'Can I convert YAML to JSON with this tool?', a: 'Yes. Click the YAML to JSON tab above the editor to convert your document to formatted JSON. Nested objects, arrays, and complex structures convert without data loss.' },
        { q: 'Does it support YAML anchors and aliases?', a: 'Yes. The parser fully supports YAML 1.2 anchors (&), aliases (*), and merge keys (<<). Both the references and the resolved values are preserved in the output.' },
        { q: 'Can I format multiple YAML documents at once?', a: 'Yes. Files with multiple documents separated by --- are processed independently, and the separators are preserved — useful for multi-resource Kubernetes manifests.' },
        { q: 'Does it preserve comments?', a: 'Yes. Comments keep their position relative to the surrounding keys and values during formatting.' },
        { q: 'Is this YAML formatter free?', a: 'Yes, completely free with no limits. No sign-up, no usage caps. The project is open source and will stay free.' },
      ].map(({ q, a }) => (
        <div class="border border-zinc-200 rounded-xl overflow-hidden bg-white">
          <dt>
            <button type="button" class="faq-toggle flex w-full items-center justify-between gap-3 px-5 py-4 text-left text-sm font-medium text-zinc-900 hover:bg-zinc-50" aria-expanded="false">
              <span>{q}</span>
              <svg class="faq-chevron w-4 h-4 text-zinc-400 shrink-0 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
          </dt>
          <dd class="faq-answer hidden px-5 pb-4 text-sm text-zinc-600 leading-relaxed">{a}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  document.querySelectorAll('.faq-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const dd = btn.closest('div')?.querySelector('.faq-answer');
      const chevron = btn.querySelector('.faq-chevron');
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isOpen));
      if (dd) dd.classList.toggle('hidden');
      if (chevron) chevron.classList.toggle('rotate-180');
    });
  });
</script>