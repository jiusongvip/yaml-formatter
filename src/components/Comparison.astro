---
---

<section id="compare" class="py-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
  <div class="text-center mb-10">
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
      Why Choose Our YAML Formatter
    </h2>
    <p class="mt-3 text-zinc-500 dark:text-zinc-400">See how we compare against the top alternatives.</p>
  </div>
  <div class="overflow-x-auto rounded-2xl border border-zinc-200 dark:border-zinc-800">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-zinc-50 dark:bg-zinc-900/50">
          <th class="text-left py-3.5 px-5 font-semibold text-zinc-900 dark:text-zinc-100">Feature</th>
          <th class="text-center py-3.5 px-5 font-semibold text-white bg-emerald-600 rounded-tl-lg">Our Tool</th>
          <th class="text-center py-3.5 px-5 text-zinc-500 dark:text-zinc-400">jsonformatter</th>
          <th class="text-center py-3.5 px-5 text-zinc-500 dark:text-zinc-400">codebeautify</th>
          <th class="text-center py-3.5 px-5 text-zinc-500 dark:text-zinc-400">yamlchecker</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
        {[
          ['Client-side processing', 'No data leaves your browser', true, false, false, true],
          ['No ads', 'Clean, focused interface', true, false, false, true],
          ['Syntax highlighting', 'YAML-aware color coding', true, true, true, true],
          ['YAML to JSON', 'Bidirectional conversion', true, true, false, false],
          ['Multi-document YAML', 'Handles --- separators', true, false, false, false],
          ['Anchor & Alias support', 'Preserves references', true, false, false, false],
          ['Dark mode', 'Auto system theme', true, false, false, false],
          ['Open source', 'Public GitHub repo', true, false, false, false],
          ['Keyboard shortcuts', 'Ctrl+Enter to format', true, false, false, false],
        ].map(([feature, note, ...checks]) => (
          <tr class="hover:bg-zinc-50/50 dark:hover:bg-zinc-900/30 transition-colors">
            <td class="py-3 px-5">
              <div class="font-medium text-zinc-800 dark:text-zinc-200">{feature as string}</div>
              <div class="text-xs text-zinc-400 dark:text-zinc-500 mt-0.5">{note as string}</div>
            </td>
            {checks.map((c, i) => (
              <td class="py-3 px-5 text-center">
                {c
                  ? <svg class="w-5 h-5 text-emerald-500 mx-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  : <svg class="w-5 h-5 text-zinc-300 dark:text-zinc-600 mx-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                }
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
