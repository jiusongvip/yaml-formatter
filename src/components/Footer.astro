---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-tool py-12">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div>
        <p class="font-semibold text-zinc-900 text-[15px]">YAML Formatter</p>
        <p class="mt-1.5 text-sm max-w-sm">
          Format, validate and convert YAML and JSON. Runs entirely in your browser —
          nothing is ever uploaded.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-6 sm:items-center">
        <div class="flex flex-col gap-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Tools</span>
          <a href="/#formatter" class="text-sm">Formatter</a>
          <a href="/#yaml-to-json" class="text-sm">YAML to JSON</a>
          <a href="/#yaml-to-toml" class="text-sm">YAML to TOML</a>
          <a href="/#yaml-to-xml" class="text-sm">YAML to XML</a>
          <a href="/#json-to-yaml" class="text-sm">JSON to YAML</a>
        </div>
        <div class="flex flex-col gap-2">
          <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400">Site</span>
          <a href="/#yaml-guide" class="text-sm">Guide</a>
          <a href="/privacy/" class="text-sm">Privacy</a>
        </div>
      </div>
    </div>
    <div class="mt-10 pt-6 border-t border-zinc-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm">
      <p>© {year} YAML Formatter</p>
      <p>Free to use · Open source · No tracking</p>
    </div>
  </div>
</footer>