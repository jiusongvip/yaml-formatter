---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ToolPanel from '../components/ToolPanel';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import UseCases from '../components/UseCases.astro';
import RelatedTools from '../components/RelatedTools.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'YAML Formatter',
      url: 'https://yaml-formatter.com',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      description: 'Free online YAML formatter, validator, and converter that runs entirely in your browser. Format, validate, beautify, and convert YAML to JSON instantly with zero server upload. Supports YAML 1.2, anchors, aliases, multi-document files, and syntax highlighting.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      browserRequirements: 'Requires JavaScript',
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        { '@type': 'Question', name: 'Is my YAML data safe? Does it get uploaded?', acceptedAnswer: { '@type': 'Answer', text: 'No. Everything runs entirely in your browser using client-side JavaScript. Your YAML data is never transmitted to any server. You can verify this by disconnecting your internet after loading the page and the formatter will continue to work.' } },
        { '@type': 'Question', name: 'Can I convert YAML to JSON with this tool?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Click the YAML to JSON tab above the editor to instantly convert your YAML document to properly formatted JSON. The conversion handles nested objects, arrays, and complex data structures without data loss.' } },
        { '@type': 'Question', name: 'Does it support YAML anchors and aliases?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. The parser fully supports YAML 1.2 anchors (&), aliases (*), and merge keys (<<). Both the anchor references and the resolved values are preserved in the formatted output.' } },
        { '@type': 'Question', name: 'Can I format multiple YAML documents at once?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. YAML files can contain multiple documents separated by ---. Our formatter processes each document independently and preserves the document separators.' } },
        { '@type': 'Question', name: 'Is this YAML formatter free?', acceptedAnswer: { '@type': 'Answer', text: 'Yes, completely free with no limits. No sign-up required, no usage caps, no premium tiers. The project is open source and will always remain free.' } },
        { '@type': 'Question', name: 'Can I use this tool offline?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Once the page is loaded, all processing happens locally in your browser. Disconnect from the internet and the formatter continues to work.' } },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://yaml-formatter.com' },
        { '@type': 'ListItem', position: 2, name: 'YAML Formatter', item: 'https://yaml-formatter.com/#formatter' },
      ],
    },
  ],
};
---

<BaseLayout
  title="YAML Formatter - Free Online YAML Beautifier & Validator"
  description="Free online YAML formatter that runs entirely in your browser. Format, validate, and convert YAML to JSON instantly. 100% client-side, zero server upload."
>
  <Header />
  <main>
    <Hero />
    <ToolPanel client:idle />
    <Features />
    <HowItWorks />
    <UseCases />
    <RelatedTools />
    <FAQ />
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>