---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ToolPanel from '../components/ToolPanel';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import UseCases from '../components/UseCases.astro';
import YamlGuideSection from '../components/YamlGuideSection.astro';
import TypeMapping from '../components/TypeMapping.astro';
import Examples from '../components/Examples.astro';
import CommonErrorsSection from '../components/CommonErrorsSection.astro';
import FormatComparisonSection from '../components/FormatComparisonSection.astro';
import Comparison from '../components/Comparison.astro';
import RelatedTools from '../components/RelatedTools.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'YAML Formatter',
      url: 'https://yaml-formatter.com',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      description: 'Free online YAML formatter, validator, and converter that runs entirely in your browser. Format, validate, beautify, and convert YAML to JSON instantly with zero server upload. Supports YAML 1.2, anchors, aliases, multi-document files, and syntax highlighting.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      browserRequirements: 'Requires JavaScript',
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        { '@type': 'Question', name: 'Is my YAML data safe? Does it get uploaded?', acceptedAnswer: { '@type': 'Answer', text: 'No. Everything runs entirely in your browser using client-side JavaScript. Your YAML data is never transmitted to any server. You can verify this by disconnecting your internet after loading the page and the formatter will continue to work.' } },
        { '@type': 'Question', name: 'Can I convert YAML to JSON with this tool?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Click the YAML to JSON tab above the editor to instantly convert your YAML document to properly formatted JSON. The conversion handles nested objects, arrays, and complex data structures without data loss.' } },
        { '@type': 'Question', name: 'How do I convert JSON back to YAML?', acceptedAnswer: { '@type': 'Answer', text: 'Switch to the JSON to YAML tab, paste your JSON, and get clean block-style YAML instantly. Strings that could be misread are quoted automatically so values round-trip exactly.' } },
        { '@type': 'Question', name: 'Is the conversion accurate?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. The parser follows the YAML 1.2 specification, so data types, nesting, and values are preserved exactly — the conversion is lossless.' } },
        { '@type': 'Question', name: 'Does it support YAML anchors and aliases?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. The parser fully supports YAML 1.2 anchors (&), aliases (*), and merge keys (<<). Both the anchor references and the resolved values are preserved in the formatted output.' } },
        { '@type': 'Question', name: 'How do I expand YAML anchors and aliases?', acceptedAnswer: { '@type': 'Answer', text: 'Tick the Expand anchors checkbox in the Format tab. Anchors (&), aliases (*), and merge keys (<<) are resolved into their full values, so you can see exactly what your tooling receives.' } },
        { '@type': 'Question', name: 'Can I convert YAML to TOML?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Switch to the YAML to TOML tab to convert your document to TOML. Nested mappings become [table] sections, object arrays become [[array.of.tables]], and strings are quoted correctly. TOML has no null literal, so null values are omitted.' } },
        { '@type': 'Question', name: 'What happens to YAML comments during conversion?', acceptedAnswer: { '@type': 'Answer', text: 'Comments are dropped when converting to JSON because JSON has no comment syntax. When formatting YAML without converting, comments are preserved in place.' } },
        { '@type': 'Question', name: 'How are YAML data types mapped to JSON?', acceptedAnswer: { '@type': 'Answer', text: 'Strings, numbers, booleans, and null map directly. YAML sequences become JSON arrays, mappings become objects, and dates become ISO 8601 strings.' } },
        { '@type': 'Question', name: 'Why do some strings come out quoted?', acceptedAnswer: { '@type': 'Answer', text: 'Values that look like booleans in older YAML dialects — yes, no, on, off — or that read as numbers are quoted so the YAML parses back to the original string.' } },
        { '@type': 'Question', name: 'Can I format multiple YAML documents at once?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. YAML files can contain multiple documents separated by ---. Our formatter processes each document independently and preserves the document separators.' } },
        { '@type': 'Question', name: 'Does it preserve comments when formatting?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Comments keep their position relative to the surrounding keys and values during formatting.' } },
        { '@type': 'Question', name: 'Can I convert large files?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Thousands of lines convert in moments, entirely client-side. Drag and drop .yaml, .yml, or .json files straight into the editor.' } },
        { '@type': 'Question', name: 'Is this YAML formatter free?', acceptedAnswer: { '@type': 'Answer', text: 'Yes, completely free with no limits. No sign-up required, no usage caps, no premium tiers. The project is open source and will always remain free.' } },
        { '@type': 'Question', name: 'Can I use this tool offline?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Once the page is loaded, all processing happens locally in your browser. Disconnect from the internet and the formatter continues to work.' } },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://yaml-formatter.com' },
        { '@type': 'ListItem', position: 2, name: 'YAML Formatter', item: 'https://yaml-formatter.com/#formatter' },
      ],
    },
  ],
};
---

<BaseLayout
  title="YAML Formatter - Free Online YAML Beautifier & Validator"
  description="Free online YAML formatter, validator, and YAML to JSON converter. Format, validate, and convert with tree view, diff, and JSON Schema support — 100% client-side."
>
  <Header />
  <main>
    <Hero />
    <ToolPanel client:idle />
    <Features />
    <HowItWorks />
    <UseCases />
    <YamlGuideSection />
    <TypeMapping />
    <Examples />
    <CommonErrorsSection />
    <FormatComparisonSection />
    <Comparison />
    <FAQ />
    <RelatedTools />
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>