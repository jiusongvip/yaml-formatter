---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ToolPanel from '../components/ToolPanel';
import TableOfContents from '../components/TableOfContents.astro';
import YamlIntro from '../components/YamlIntro.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import UseCases from '../components/UseCases.astro';
import YamlSyntax from '../components/YamlSyntax.astro';
import FormatComparison from '../components/FormatComparison.astro';
import ExamplesGallery from '../components/ExamplesGallery.astro';
import CommonErrors from '../components/CommonErrors.astro';
import BestPractices from '../components/BestPractices.astro';
import YamlGlossary from '../components/YamlGlossary.astro';
import Comparison from '../components/Comparison.astro';
import SecurityConsiderations from '../components/SecurityConsiderations.astro';
import RelatedTools from '../components/RelatedTools.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'YAML Formatter',
      url: 'https://yaml-formatter.com',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      description: 'Free online YAML formatter, validator, and converter that runs entirely in your browser. Format, validate, beautify, and convert YAML to JSON instantly with zero server upload. Supports YAML 1.2, anchors, aliases, multi-document files, and syntax highlighting.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      browserRequirements: 'Requires JavaScript',
    },
    {
      '@type': 'SoftwareApplication',
      name: 'YAML Formatter',
      url: 'https://yaml-formatter.com',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      description: 'Free online YAML formatter, validator, and converter that runs entirely in your browser. No server upload required. Supports YAML 1.2, syntax highlighting, multi-document files, and YAML-to-JSON conversion.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },

    {
      '@type': 'FAQPage',
      mainEntity: [
        { '@type': 'Question', name: 'What is a YAML formatter?', acceptedAnswer: { '@type': 'Answer', text: 'A YAML formatter takes messy, inconsistently-indented YAML and reformats it with consistent spacing, proper indentation, and clean structure without changing the data. It automatically fixes mixed tabs/spaces, aligns nested blocks, and normalizes whitespace.' } },
        { '@type': 'Question', name: 'Is my YAML data safe? Does it get uploaded?', acceptedAnswer: { '@type': 'Answer', text: 'No. Everything runs entirely in your browser using client-side JavaScript. Your YAML data is never transmitted to any server. You can verify this by disconnecting your internet after loading the page and the formatter will continue to work.' } },
        { '@type': 'Question', name: 'Can I convert YAML to JSON with this tool?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Click the YAML to JSON tab above the editor to instantly convert your YAML document to properly formatted JSON. The conversion handles nested objects, arrays, and complex data structures without data loss.' } },
        { '@type': 'Question', name: 'Does it support YAML anchors and aliases?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. The parser fully supports YAML 1.2 anchors (&), aliases (*), and merge keys (<<). Both the anchor references and the resolved values are preserved in the formatted output.' } },
        { '@type': 'Question', name: 'Can I format multiple YAML documents at once?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. YAML files can contain multiple documents separated by ---. Our formatter processes each document independently and preserves the document separators.' } },
        { '@type': 'Question', name: 'What YAML specification does this follow?', acceptedAnswer: { '@type': 'Answer', text: 'We follow the YAML 1.2 specification, the latest version. It resolves several ambiguities from YAML 1.1, including proper handling of booleans, null values, and octal number parsing.' } },
        { '@type': 'Question', name: 'Does this tool preserve YAML comments?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Comments in your YAML are preserved during formatting. They maintain their original position relative to the surrounding keys and values.' } },
        { '@type': 'Question', name: 'What keyboard shortcuts are available?', acceptedAnswer: { '@type': 'Answer', text: 'The editor supports Ctrl+Enter to format, Ctrl+Z/Ctrl+Y for undo/redo, Ctrl+F for search. Standard CodeMirror shortcuts for cut, copy, paste, and line operations are also supported.' } },
        { '@type': 'Question', name: 'Is this YAML formatter free?', acceptedAnswer: { '@type': 'Answer', text: 'Yes, completely free with no limits. No sign-up required, no usage caps, no premium tiers. The project is open source and will always remain free.' } },
        { '@type': 'Question', name: 'Can I use this tool offline?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Once the page is loaded, all processing happens locally in your browser. Disconnect from the internet and the formatter continues to work.' } },
        { '@type': 'Question', name: 'Why does my YAML have indentation errors?', acceptedAnswer: { '@type': 'Answer', text: 'Common causes include mixing tabs and spaces (YAML only allows spaces), inconsistent indentation levels, or incorrect nesting of lists and mappings. Our editor highlights syntax errors in real-time with line-level precision.' } },
        { '@type': 'Question', name: 'How large a file can I format?', acceptedAnswer: { '@type': 'Answer', text: 'The tool handles files with thousands of lines efficiently. For extremely large files (10,000+ lines), formatting may take a moment. The CodeMirror editor is optimized for large documents and maintains smooth scrolling.' } },
      ],
    },
    {
      '@type': 'HowTo',
      name: 'How to Format YAML Online',
      step: [
        { '@type': 'HowToStep', position: 1, name: 'Paste or Upload Your YAML', text: 'Copy your YAML from any source and paste it into the left editor panel. Alternatively, drag and drop a .yaml or .yml file.' },
        { '@type': 'HowToStep', position: 2, name: 'Format and Validate Instantly', text: 'Our formatter processes your YAML locally using a YAML 1.2 compliant parser. It normalizes indentation, fixes spacing, and checks for syntax errors in milliseconds.' },
        { '@type': 'HowToStep', position: 3, name: 'Copy, Convert, or Compare', text: 'Copy the formatted output, convert it to JSON, or switch to the Diff tab to compare before and after.' },
      ],
    },
    {
      '@type': 'Organization',
      name: 'YAML Formatter',
      url: 'https://yaml-formatter.com',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://yaml-formatter.com' },
        { '@type': 'ListItem', position: 2, name: 'YAML Formatter', item: 'https://yaml-formatter.com/#formatter' },
      ],
    },
  ],
};
---

<BaseLayout
  title="YAML Formatter - Free Online YAML Beautifier & Validator"
  description="Free online YAML formatter that runs entirely in your browser. Format, validate, and convert YAML to JSON instantly. 100% client-side, zero server upload."
>
  <Header />
  <main>
    <Hero />
    <ToolPanel client:idle />
    <TableOfContents />
    <YamlIntro />
    <Features />
    <Comparison />
    <HowItWorks />
    <UseCases />
    <YamlSyntax />
    <FormatComparison />
    <ExamplesGallery />
    <CommonErrors />
    <BestPractices />
    <YamlGlossary />
    <SecurityConsiderations />
    <RelatedTools />
    <FAQ />
  </main>
  <Footer />

  <!-- Scroll to top -->
  <button id="scroll-top" class="fixed bottom-6 right-6 z-50 w-10 h-10 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white shadow-lg flex items-center justify-center transition-all" aria-label="Scroll to top">
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
  </button>
  <script>
    const btn = document.getElementById('scroll-top');
    window.addEventListener('scroll', () => {
      btn.classList.toggle('visible', window.scrollY > 500);
    });
    btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
