---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CaseConverter from '../components/CaseConverter';

const faqs = [
  { q: 'Is the case conversion instant?', a: 'Yes. The output updates live as you type — there is no button to press and nothing is sent to a server. Every keystroke is transformed locally in your browser.' },
  { q: 'Does the converter work offline?', a: 'Once the page is loaded, all conversion happens client-side. Disconnect from the internet and the tool keeps working normally.' },
  { q: 'What is the difference between capitalized and title case?', a: 'Capitalized case uppercases the first letter of every word. Title case uses capitalization rules — it keeps small stop words like "an", "and", or "the" lowercase unless they begin the title.' },
  { q: 'Can I convert a whole file at once?', a: 'Yes. Paste the entire file into the editor. Multi-line text, blank lines, and punctuation are preserved; only the letter casing changes.' },
  { q: 'Does it handle numbers and symbols?', a: 'Yes. Digits, punctuation, and special characters are left untouched. Only letters are converted, so output stays valid for code, URLs, and identifiers.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Case Converter',
      url: 'https://yaml-formatter.com/case-converter',
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Any',
      description: 'Free online case converter with 7 modes: sentence, lower, upper, capitalized, alternating, title and inverse. Runs entirely in the browser, zero upload.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      browserRequirements: 'Requires JavaScript',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(f => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://yaml-formatter.com' },
        { '@type': 'ListItem', position: 2, name: 'Case Converter' },
      ],
    },
  ],
};
---

<BaseLayout
  title="Case Converter - Sentence, UPPER, Title & aLtErNaTiNg Cases Online"
  description="Convert text to sentence case, lower case, UPPER CASE, Capitalized, aLtErNaTiNg cAsE, Title Case or InVeRsE CaSe. 7 modes, live output, 100% in your browser."
>
  <Header />
  <main>
    <section class="container-tool pt-16 md:pt-20 pb-6 text-center">
      <nav class="flex items-center justify-center gap-2 text-sm text-zinc-400 mb-6">
        <a href="/" class="text-zinc-500 hover:text-zinc-900">Home</a>
        <span>/</span>
        <span class="text-zinc-700">Case Converter</span>
      </nav>
      <h1 class="display">Case Converter</h1>
      <p class="lead mt-6 max-w-2xl mx-auto">
        Shift any text into sentence case, lower case, UPPER CASE, Title Case
        and more — live, as you type. The output updates instantly.
      </p>
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-zinc-200 bg-zinc-50 text-sm text-zinc-600 mt-6">
        <svg class="w-4 h-4 text-blue-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Your text never leaves your browser.
      </span>
    </section>

    <CaseConverter client:idle />

    <section class="container-tool section">
      <div class="flex items-center gap-4 mb-10">
        <span class="eyebrow shrink-0">The 7 modes</span>
        <span class="divider grow" aria-hidden="true"></span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
        <div class="p-5 rounded-2xl border border-zinc-200 bg-white">
          <b class="font-semibold">Sentence case</b>
          <p class="mt-1.5 text-zinc-500 leading-relaxed">Capitalizes the first letter of each sentence, lowercases the rest, and turns standalone "i" into "I".</p>
        </div>
        <div class="p-5 rounded-2xl border border-zinc-200 bg-white">
          <b class="font-semibold">Lower case</b>
          <p class="mt-1.5 text-zinc-500 leading-relaxed">Drops every letter to lowercase for uniform, flat output.</p>
        </div>
        <div class="p-5 rounded-2xl border border-zinc-200 bg-white">
          <b class="font-semibold">UPPER CASE</b>
          <p class="mt-1.5 text-zinc-500 leading-relaxed">Shouts it: every letter becomes an uppercase glyph.</p>
        </div>
        <div class="p-5 rounded-2xl border border-zinc-200 bg-white">
          <b class="font-semibold">Capitalized Case</b>
          <p class="mt-1.5 text-zinc-500 leading-relaxed">Capitalizes the first letter of every word, leaving the remainder lowercase.</p>
        </div>
        <div class="p-5 rounded-2xl border border-zinc-200 bg-white">
          <b class="font-semibold">aLtErNaTiNg cAsE</b>
          <p class="mt-1.5 text-zinc-500 leading-relaxed">Weaves upper and lower letters inside each word — the classic meme aesthetic.</p>
        </div>
        <div class="p-5 rounded-2xl border border-zinc-200 bg-white">
          <b class="font-semibold">Title Case</b>
          <p class="mt-1.5 text-zinc-500 leading-relaxed">Capitalizes meaningful words while keeping small stop words like "an" lowercased.</p>
        </div>
        <div class="p-5 rounded-2xl border border-zinc-200 bg-white sm:col-span-2">
          <b class="font-semibold">InVeRsE CaSe</b>
          <p class="mt-1.5 text-zinc-500 leading-relaxed">Flips every letter: UPPER becomes lower and lower becomes UPPER.</p>
        </div>
      </div>
    </section>

    <section class="section band-soft">
      <div class="container-tool max-w-4xl">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <p class="eyebrow">Why use it</p>
          <h2 class="h-section mt-3">When case matters</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
            <h3 class="h-sub">Code consistency</h3>
            <p class="mt-2 text-zinc-500 leading-relaxed">Normalize API responses or configs to match your project's casing convention before committing.</p>
          </div>
          <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
            <h3 class="h-sub">Cleaner datasets</h3>
            <p class="mt-2 text-zinc-500 leading-relaxed">Squash inconsistent casing in exported CSV or spreadsheet columns into a uniform style.</p>
          </div>
          <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
            <h3 class="h-sub">Headlines &amp; titles</h3>
            <p class="mt-2 text-zinc-500 leading-relaxed">Turn a plain draft into properly capitalized title case for articles, posts, and page headings.</p>
          </div>
          <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
            <h3 class="h-sub">Quick social edits</h3>
            <p class="mt-2 text-zinc-500 leading-relaxed">Reformat a caption or message into aLtErNaTiNg cAsE for emphasis, without retyping.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container-tool max-w-3xl">
        <h2 class="h-section text-center mb-10">Frequently asked questions</h2>
        <dl class="space-y-3">
          {faqs.map(f => (
            <div class="border border-zinc-200 rounded-xl overflow-hidden bg-white">
              <dt><button type="button" class="faq-toggle flex w-full items-center justify-between gap-3 px-5 py-4 text-left text-sm font-medium text-zinc-900 hover:bg-zinc-50" aria-expanded="false"><span>{f.q}</span><svg class="faq-chevron w-4 h-4 text-zinc-400 shrink-0 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button></dt>
              <dd class="faq-answer hidden px-5 pb-4 text-sm text-zinc-600 leading-relaxed">{f.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="container-tool section pt-0">
      <h2 class="h-section text-center mb-10">Related tools</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 max-w-4xl mx-auto">
        <a href="/" class="p-6 rounded-2xl border border-zinc-200 bg-white no-underline block hover:bg-zinc-50">
          <h3 class="h-sub">YAML Formatter</h3>
          <p class="mt-2 text-sm text-zinc-500">Format and validate YAML with consistent indentation.</p>
        </a>
        <a href="/yaml-to-json" class="p-6 rounded-2xl border border-zinc-200 bg-white no-underline block hover:bg-zinc-50">
          <h3 class="h-sub">YAML to JSON</h3>
          <p class="mt-2 text-sm text-zinc-500">Convert YAML to properly formatted JSON.</p>
        </a>
        <a href="/json-to-yaml" class="p-6 rounded-2xl border border-zinc-200 bg-white no-underline block hover:bg-zinc-50">
          <h3 class="h-sub">JSON to YAML</h3>
          <p class="mt-2 text-sm text-zinc-500">Convert JSON back to clean, readable YAML.</p>
        </a>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    document.querySelectorAll(".faq-toggle").forEach((e) => {
      e.addEventListener("click", () => {
        const answer = e.closest("div")?.querySelector(".faq-answer");
        const chevron = e.querySelector(".faq-chevron");
        const expanded = e.getAttribute("aria-expanded") === "true";
        e.setAttribute("aria-expanded", String(!expanded));
        answer?.classList.toggle("hidden");
        chevron?.classList.toggle("rotate-180");
      });
    });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>