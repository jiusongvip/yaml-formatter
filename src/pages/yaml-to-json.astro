---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPanel from '../components/ToolPanel';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'YAML to JSON Converter',
      url: 'https://yaml-formatter.com/yaml-to-json',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      description: 'Free online YAML to JSON converter. Convert YAML to JSON instantly in your browser — no server upload, no registration. Handles nested objects, arrays, anchors, and multi-document YAML.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      browserRequirements: 'Requires JavaScript',
    },
    {
      '@type': 'HowTo',
      name: 'How to Convert YAML to JSON',
      step: [
        { '@type': 'HowToStep', position: 1, name: 'Paste or Upload YAML', text: 'Paste your YAML content or drag and drop a .yaml file into the editor.' },
        { '@type': 'HowToStep', position: 2, name: 'Click the YAML to JSON tab', text: 'The conversion happens instantly in your browser using the yaml.js parser. All data stays local.' },
        { '@type': 'HowToStep', position: 3, name: 'Copy the JSON', text: 'Copy the formatted JSON output and use it in your API, application, or data pipeline.' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        { '@type': 'Question', name: 'Is the YAML to JSON conversion accurate?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. We use the yaml library (v2) which follows the YAML 1.2 specification. All data types, nested structures, and values are preserved exactly during conversion. The conversion is fully lossless.' } },
        { '@type': 'Question', name: 'Does this tool send my data to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. All YAML to JSON conversion runs entirely in your browser using client-side JavaScript. Your data never leaves your computer. You can disconnect from the internet and the converter will continue to work.' } },
        { '@type': 'Question', name: 'Does it handle YAML anchors and aliases?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. YAML anchors (&) and aliases (*) are fully resolved during conversion. The resulting JSON contains the expanded, actual values. Merge keys (<<) are also supported.' } },
        { '@type': 'Question', name: 'Can I convert large YAML files?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. The tool handles files with thousands of lines efficiently. For extremely large files (10,000+ lines), conversion may take a moment but remains fully client-side. You can also drag and drop .yaml or .yml files directly into the editor.' } },
        { '@type': 'Question', name: 'What happens to YAML comments during conversion?', acceptedAnswer: { '@type': 'Answer', text: 'Comments are dropped during conversion because JSON does not support comments. This is by design — the JSON specification has no comment syntax.' } },
        { '@type': 'Question', name: 'How are YAML data types mapped to JSON?', acceptedAnswer: { '@type': 'Answer', text: 'YAML strings, numbers, booleans, and null map directly to JSON equivalents. YAML sequences become JSON arrays. YAML mappings become JSON objects. YAML dates are converted to ISO 8601 strings.' } },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://yaml-formatter.com' },
        { '@type': 'ListItem', position: 2, name: 'YAML to JSON Converter' },
      ],
    },
  ],
};
---

<BaseLayout
  title="YAML to JSON Converter - Free Online YAML to JSON Tool"
  description="Convert YAML to JSON instantly in your browser. Free online converter, zero server upload. Supports nested objects, arrays, anchors, and aliases."
>
  <header class="sticky top-0 z-50 border-b border-zinc-200/60 dark:border-zinc-800/60 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md">
    <nav class="max-w-7xl mx-auto flex items-center justify-between h-14 px-4 sm:px-6 lg:px-8">
      <a href="/" class="flex items-center gap-2.5 group">
        <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-emerald-600 text-white font-bold text-sm group-hover:bg-emerald-700 transition-colors">Y</span>
        <span class="font-semibold text-base tracking-tight text-zinc-900 dark:text-zinc-100">YAML Formatter</span>
      </a>
      <div class="flex items-center gap-4">
        <a href="/" class="text-sm text-zinc-500 dark:text-zinc-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Formatter</a>
        <a href="/blog/yaml-syntax-guide" class="text-sm text-zinc-500 dark:text-zinc-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Blog</a>
        <button id="theme-toggle" class="p-2 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100" aria-label="Toggle theme">
          <svg id="sun-icon" class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg id="moon-icon" class="w-4 h-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </div>
    </nav>
  </header>
  <script>
    const btn = document.getElementById('theme-toggle');
    btn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  </script>

  <main>
    <section class="pt-20 pb-6 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center">
      <nav class="flex items-center justify-center gap-2 text-sm text-zinc-400 dark:text-zinc-500 mb-4">
        <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
        <span>/</span>
        <span class="text-zinc-600 dark:text-zinc-300">YAML to JSON Converter</span>
      </nav>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tighter text-zinc-900 dark:text-zinc-50">YAML to JSON Converter</h1>
      <p class="mt-4 text-lg sm:text-xl text-zinc-500 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed">Convert YAML to JSON <span class="text-zinc-700 dark:text-zinc-300 font-medium">instantly</span> in your browser. No upload, no server.</p>
      <div class="mt-6 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800 text-sm text-emerald-700 dark:text-emerald-300 font-medium">
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Your data never leaves your browser. 100% client-side.
      </div>
    </section>

    <ToolPanel client:idle initialTab="to-json" />

    <!-- Code Comparison -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-3 text-center">YAML to JSON: Side-by-Side Comparison</h2>
      <p class="text-center text-zinc-500 dark:text-zinc-400 mb-8 max-w-2xl mx-auto">See how the same data structure looks in YAML versus JSON. YAML uses indentation and minimal syntax, while JSON uses braces, brackets, and quotes.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 overflow-hidden">
          <div class="px-4 py-2 bg-zinc-100 dark:bg-zinc-800 border-b border-zinc-200 dark:border-zinc-700 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-semibold text-zinc-600 dark:text-zinc-300">YAML Input</span>
          </div>
          <pre id="cmp-yaml" class="p-4 text-sm font-mono"></pre>
        </div>
        <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 overflow-hidden">
          <div class="px-4 py-2 bg-zinc-100 dark:bg-zinc-800 border-b border-zinc-200 dark:border-zinc-700 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
            <span class="text-xs font-semibold text-zinc-600 dark:text-zinc-300">JSON Output</span>
          </div>
          <pre id="cmp-json" class="p-4 text-sm font-mono"></pre>
        </div>
      </div>
    </section>

    <!-- Key Features -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-8 text-center">Key Features</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <div class="p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <div class="w-9 h-9 rounded-lg bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
          </div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1.5">YAML 1.2 Compliant</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Full support for the YAML 1.2 specification including proper boolean handling, null values, and numeric type detection.</p>
        </div>
        <div class="p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <div class="w-9 h-9 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          </div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1.5">100% Client-Side</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">All conversion runs in your browser. Your data is never uploaded to any server. Works offline after page load.</p>
        </div>
        <div class="p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <div class="w-9 h-9 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-purple-600 dark:text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1.5">Anchor Resolution</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">YAML anchors (&amp;) and aliases (*) are fully resolved. The JSON output contains expanded, actual values.</p>
        </div>
        <div class="p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <div class="w-9 h-9 rounded-lg bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1.5">Multi-Document Support</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Handles YAML files with multiple documents separated by <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">---</code>. Each document is converted independently.</p>
        </div>
        <div class="p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <div class="w-9 h-9 rounded-lg bg-red-100 dark:bg-red-900/30 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-red-600 dark:text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1.5">Syntax Error Detection</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Instant error reporting with exact line and column numbers. Get actionable hints to fix common YAML syntax issues.</p>
        </div>
        <div class="p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <div class="w-9 h-9 rounded-lg bg-cyan-100 dark:bg-cyan-900/30 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-cyan-600 dark:text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          </div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1.5">File Drag &amp; Drop</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Drag and drop <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">.yaml</code> or <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">.yml</code> files directly into the editor for instant conversion.</p>
        </div>
      </div>
    </section>

    <!-- Why Convert YAML to JSON -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-3 text-center">Why Convert YAML to JSON?</h2>
      <p class="text-center text-zinc-500 dark:text-zinc-400 mb-8 max-w-2xl mx-auto">YAML and JSON serve different purposes. Converting between them is a daily task for developers working across configuration, APIs, and data pipelines.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-2">REST API Payloads</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Most REST APIs expect JSON request bodies. Write your payloads in readable YAML, then convert to JSON for <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">curl</code>, Postman, or HTTP clients.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-2">JavaScript / TypeScript Apps</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">JavaScript natively parses JSON with <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">JSON.parse()</code>. Convert YAML configs to JSON for zero-dependency loading in Node.js or browser apps.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-2">NoSQL Database Import</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">MongoDB, CouchDB, and Elasticsearch use JSON documents. Convert your YAML seed data or fixtures to JSON for direct database import.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-2">CI/CD Pipeline Config</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Some tools require JSON while others use YAML. Convert between formats when migrating between GitHub Actions, GitLab CI, or Jenkins pipelines.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-2">Schema Validation</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">JSON Schema is the industry standard for data validation. Convert your YAML data to JSON to validate against schemas using tools like Ajv or Express middleware.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-2">Infrastructure as Code</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Terraform, CloudFormation, and Pulumi accept JSON templates. Convert from YAML versions for compatibility with tools that only accept JSON input.</p>
        </div>
      </div>
    </section>

    <!-- YAML vs JSON Key Differences -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-8 text-center">YAML vs JSON: Key Differences</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border border-zinc-200 dark:border-zinc-800 rounded-xl overflow-hidden">
          <thead>
            <tr class="bg-zinc-50 dark:bg-zinc-900">
              <th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300 border-b border-zinc-200 dark:border-zinc-800">Feature</th>
              <th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300 border-b border-zinc-200 dark:border-zinc-800">YAML</th>
              <th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300 border-b border-zinc-200 dark:border-zinc-800">JSON</th>
            </tr>
          </thead>
          <tbody class="text-zinc-600 dark:text-zinc-400">
            <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-medium text-zinc-800 dark:text-zinc-200">Syntax</td><td class="px-4 py-2.5">Indentation-based, minimal punctuation</td><td class="px-4 py-2.5">Braces, brackets, quotes, commas</td></tr>
            <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-medium text-zinc-800 dark:text-zinc-200">Comments</td><td class="px-4 py-2.5">Supported (<code class="text-xs">#</code>)</td><td class="px-4 py-2.5">Not supported</td></tr>
            <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-medium text-zinc-800 dark:text-zinc-200">Data Types</td><td class="px-4 py-2.5">Strings, numbers, booleans, null, dates</td><td class="px-4 py-2.5">Strings, numbers, booleans, null</td></tr>
            <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-medium text-zinc-800 dark:text-zinc-200">Anchors / References</td><td class="px-4 py-2.5">Supported (<code class="text-xs">&amp;</code> / <code class="text-xs">*</code>)</td><td class="px-4 py-2.5">Not supported</td></tr>
            <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-medium text-zinc-800 dark:text-zinc-200">Multi-document</td><td class="px-4 py-2.5">Supported (<code class="text-xs">---</code> separator)</td><td class="px-4 py-2.5">Not supported</td></tr>
            <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-medium text-zinc-800 dark:text-zinc-200">File Size</td><td class="px-4 py-2.5">More compact (no quotes/braces)</td><td class="px-4 py-2.5">Larger (verbose syntax)</td></tr>
            <tr><td class="px-4 py-2.5 font-medium text-zinc-800 dark:text-zinc-200">Parsing Speed</td><td class="px-4 py-2.5">Slower (complex spec)</td><td class="px-4 py-2.5">Faster (simple spec, native support)</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- How It Works -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-3 text-center">How to Convert YAML to JSON</h2>
      <p class="text-center text-zinc-500 dark:text-zinc-400 mb-10 max-w-2xl mx-auto">Three simple steps to convert your YAML documents to JSON format — all processed locally in your browser.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 font-bold text-lg mb-4">1</span>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 text-lg mb-2">Paste Your YAML</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">Copy your YAML from any source — a Kubernetes manifest, a CI/CD pipeline, or a configuration file — and paste it into the editor. You can also drag and drop <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">.yaml</code> files directly.</p>
        </div>
        <div class="text-center">
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 font-bold text-lg mb-4">2</span>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 text-lg mb-2">Click YAML to JSON</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">Switch to the "YAML to JSON" tab above the editor. The conversion happens instantly using the <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">yaml</code> library (v2), which follows the YAML 1.2 specification.</p>
        </div>
        <div class="text-center">
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-300 font-bold text-lg mb-4">3</span>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 text-lg mb-2">Copy the JSON</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">Copy the formatted JSON output with one click. Use it in your REST API, Node.js application, NoSQL database import, or any tool that expects JSON input.</p>
        </div>
      </div>
    </section>

    <!-- Common Conversion Errors -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-3 text-center">Common Conversion Errors</h2>
      <p class="text-center text-zinc-500 dark:text-zinc-400 mb-8 max-w-2xl mx-auto">Avoid these frequent pitfalls when converting between YAML and JSON formats.</p>
      <div class="space-y-4">
        <div class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1">Tabs in YAML</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">YAML forbids tab characters for indentation. Using tabs causes parse errors that prevent conversion. Replace all tabs with spaces (2 or 4 per level) before converting.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1">Unquoted Special Values</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Values like <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">true</code>, <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">false</code>, <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">null</code>, <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">yes</code>, <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">no</code> are interpreted as booleans/null in YAML. If you need them as strings, wrap them in quotes: <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">"yes"</code>.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1">Comments Lost in Conversion</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">JSON does not support comments. All YAML comments (<code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">#</code>) are dropped during conversion. Add documentation separately or use descriptive key names.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1">Inconsistent Indentation</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Mixing 2-space and 4-space indents within the same YAML block causes parse errors. Use consistent indentation throughout your document before converting.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1">Missing Colon Separator</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Every YAML mapping key requires a colon followed by a space (<code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">key: value</code>). Forgetting the colon or the trailing space is one of the most common YAML syntax errors.</p>
        </div>
      </div>
    </section>

