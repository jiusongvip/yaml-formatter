---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolPanel from '../components/ToolPanel';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'YAML to JSON Converter',
      url: 'https://yaml-formatter.com/yaml-to-json',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      description: 'Free online YAML to JSON converter. Convert YAML to JSON instantly in your browser — no server upload, no registration. Handles nested objects, arrays, anchors, and multi-document YAML.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      browserRequirements: 'Requires JavaScript',
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        { '@type': 'Question', name: 'Is the YAML to JSON conversion accurate?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. We use the yaml library (v2) which follows the YAML 1.2 specification. All data types, nested structures, and values are preserved exactly during conversion. The conversion is fully lossless.' } },
        { '@type': 'Question', name: 'Does this tool send my data to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. All YAML to JSON conversion runs entirely in your browser using client-side JavaScript. Your data never leaves your computer. You can disconnect from the internet and the converter will continue to work.' } },
        { '@type': 'Question', name: 'Does it handle YAML anchors and aliases?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. YAML anchors (&) and aliases (*) are fully resolved during conversion. The resulting JSON contains the expanded, actual values. Merge keys (<<) are also supported.' } },
        { '@type': 'Question', name: 'What happens to YAML comments during conversion?', acceptedAnswer: { '@type': 'Answer', text: 'Comments are dropped during conversion because JSON does not support comments. This is by design — the JSON specification has no comment syntax.' } },
        { '@type': 'Question', name: 'How are YAML data types mapped to JSON?', acceptedAnswer: { '@type': 'Answer', text: 'YAML strings, numbers, booleans, and null map directly to JSON equivalents. YAML sequences become JSON arrays. YAML mappings become JSON objects. YAML dates are converted to ISO 8601 strings.' } },
        { '@type': 'Question', name: 'Can I convert large YAML files?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. The tool handles files with thousands of lines efficiently, fully client-side. You can also drag and drop .yaml or .yml files directly into the editor.' } },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://yaml-formatter.com' },
        { '@type': 'ListItem', position: 2, name: 'YAML to JSON Converter' },
      ],
    },
  ],
};

const cmpYaml = `name: my-app
version: 1.0.0
description: A sample application
settings:
  debug: false
  port: 3000
  hosts:
    - localhost
    - 0.0.0.0
  database:
    host: db.example.com
    port: 5432
    name: myapp_db`;

const cmpJson = `{
  "name": "my-app",
  "version": "1.0.0",
  "description": "A sample application",
  "settings": {
    "debug": false,
    "port": 3000,
    "hosts": ["localhost", "0.0.0.0"],
    "database": {
      "host": "db.example.com",
      "port": 5432,
      "name": "myapp_db"
    }
  }
}`;

const k8sYaml = `apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx-deployment
  labels:
    app: nginx
spec:
  replicas: 3
  selector:
    matchLabels:
      app: nginx
  template:
    metadata:
      labels:
        app: nginx
    spec:
      containers:
      - name: nginx
        image: nginx:1.25
        ports:
        - containerPort: 80`;

const k8sJson = `{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "nginx-deployment",
    "labels": { "app": "nginx" }
  },
  "spec": {
    "replicas": 3,
    "selector": {
      "matchLabels": { "app": "nginx" }
    },
    "template": {
      "metadata": {
        "labels": { "app": "nginx" }
      },
      "spec": {
        "containers": [
          {
            "name": "nginx",
            "image": "nginx:1.25",
            "ports": [{ "containerPort": 80 }]
          }
        ]
      }
    }
  }
}`;

const dockerYaml = `version: "3.8"
services:
  web:
    build: .
    ports:
      - "3000:3000"
    environment:
      NODE_ENV: production
    depends_on:
      - db
      - redis
  db:
    image: postgres:15
    volumes:
      - pgdata:/var/lib/postgresql/data
    environment:
      POSTGRES_DB: myapp
  redis:
    image: redis:7-alpine
volumes:
  pgdata:`;

const dockerJson = `{
  "version": "3.8",
  "services": {
    "web": {
      "build": ".",
      "ports": ["3000:3000"],
      "environment": { "NODE_ENV": "production" },
      "depends_on": ["db", "redis"]
    },
    "db": {
      "image": "postgres:15",
      "volumes": ["pgdata:/var/lib/postgresql/data"],
      "environment": { "POSTGRES_DB": "myapp" }
    },
    "redis": {
      "image": "redis:7-alpine"
    }
  },
  "volumes": { "pgdata": null }
}`;

const ciYaml = `name: CI
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        node-version: [18, 20]
    steps:
      - uses: actions/checkout@v4
      - name: Use Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
      - run: npm ci
      - run: npm test`;

const ciJson = `{
  "name": "CI",
  "on": {
    "push": { "branches": ["main"] },
    "pull_request": { "branches": ["main"] }
  },
  "jobs": {
    "test": {
      "runs-on": "ubuntu-latest",
      "strategy": {
        "matrix": { "node-version": [18, 20] }
      },
      "steps": [
        { "uses": "actions/checkout@v4" },
        {
          "name": "Use Node.js",
          "uses": "actions/setup-node@v4",
          "with": { "node-version": 20 }
        },
        { "run": "npm ci" },
        { "run": "npm test" }
      ]
    }
  }
}`;
---

<BaseLayout
  title="YAML to JSON Converter - Free Online YAML to JSON Tool"
  description="Convert YAML to JSON instantly in your browser. Free online converter, zero server upload. Supports nested objects, arrays, anchors, and aliases."
>
  <Header />

  <main>
    <section class="container-tool pt-16 md:pt-20 pb-6 text-center">
      <nav class="flex items-center justify-center gap-2 text-sm text-zinc-400 mb-6">
        <a href="/" class="text-zinc-500 hover:text-zinc-900">Home</a>
        <span>/</span>
        <span class="text-zinc-700">YAML to JSON Converter</span>
      </nav>
      <h1 class="display">YAML to JSON</h1>
      <p class="lead mt-6 max-w-2xl mx-auto">
        Convert YAML to JSON instantly in your browser. No upload, no server —
        the conversion runs entirely on your device.
      </p>
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-zinc-200 bg-zinc-50 text-sm text-zinc-600 mt-6">
        <svg class="w-4 h-4 text-blue-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Your data never leaves your browser.
      </span>
    </section>

    <ToolPanel client:idle initialTab="to-json" />

    <section class="container-tool section">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <p class="eyebrow">Side by side</p>
        <h2 class="h-section mt-3">YAML vs JSON</h2>
        <p class="lead mt-4">The same structure in both formats. YAML favors indentation and minimal punctuation; JSON uses braces, brackets, and quotes.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <figure class="tool-card">
          <figcaption class="px-4 py-2.5 border-b border-zinc-200 bg-zinc-50 text-sm font-medium text-zinc-700">YAML input</figcaption>
          <pre class="p-5 text-[13px] leading-relaxed overflow-x-auto" set:html={cmpYaml}></pre>
        </figure>
        <figure class="tool-card">
          <figcaption class="px-4 py-2.5 border-b border-zinc-200 bg-zinc-50 text-sm font-medium text-zinc-700">JSON output</figcaption>
          <pre class="p-5 text-[13px] leading-relaxed overflow-x-auto" set:html={cmpJson}></pre>
        </figure>
      </div>
    </section>

    <section class="section band-soft">
      <div class="container-tool">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <p class="eyebrow">Why this converter</p>
          <h2 class="h-section mt-3">Built for real conversion work</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
            <h3 class="h-sub">Lossless, YAML 1.2</h3>
            <p class="mt-2 text-zinc-500 leading-relaxed">Conversion follows the YAML 1.2 spec with correct boolean, null, and numeric handling — nothing gets re-interpreted along the way.</p>
          </div>
          <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
            <h3 class="h-sub">Anchors resolved</h3>
            <p class="mt-2 text-zinc-500 leading-relaxed">Anchors (&amp;) and aliases (*) are expanded into their real values. Merge keys (&lt;&lt;) are handled too, so the JSON contains concrete data.</p>
          </div>
          <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
            <h3 class="h-sub">Multi-document</h3>
            <p class="mt-2 text-zinc-500 leading-relaxed">YAML files with multiple documents separated by <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-100">---</code> are converted independently and kept intact.</p>
          </div>
          <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
            <h3 class="h-sub">Pinpoint errors</h3>
            <p class="mt-2 text-zinc-500 leading-relaxed">Syntax problems are reported with the exact line and column, plus a plain-language hint on how to fix them.</p>
          </div>
          <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
            <h3 class="h-sub">Drag &amp; drop</h3>
            <p class="mt-2 text-zinc-500 leading-relaxed">Drop a <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-100">.yaml</code> or <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-100">.yml</code> file straight into the editor and get JSON back instantly.</p>
          </div>
          <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
            <h3 class="h-sub">Private by default</h3>
            <p class="mt-2 text-zinc-500 leading-relaxed">Everything runs client-side. There is no backend, so there is nowhere for your data to go — it works even offline.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="container-tool section">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <p class="eyebrow">Use cases</p>
        <h2 class="h-section mt-3">Why convert YAML to JSON?</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-4xl mx-auto">
        <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
          <h3 class="h-sub">REST API payloads</h3>
          <p class="mt-2 text-zinc-500 leading-relaxed">Write request bodies in readable YAML, then convert to JSON for <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-100">curl</code>, Postman, or any HTTP client.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
          <h3 class="h-sub">Node.js and browsers</h3>
          <p class="mt-2 text-zinc-500 leading-relaxed">JSON parses natively with <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-100">JSON.parse()</code>. Convert YAML configs for zero-dependency loading.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
          <h3 class="h-sub">NoSQL imports</h3>
          <p class="mt-2 text-zinc-500 leading-relaxed">MongoDB, CouchDB, and Elasticsearch consume JSON documents. Turn YAML fixtures into ready-to-import data.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
          <h3 class="h-sub">Infrastructure as code</h3>
          <p class="mt-2 text-zinc-500 leading-relaxed">Tools that only accept JSON — CloudFormation, some Terraform paths — can consume your YAML configs after conversion.</p>
        </div>
      </div>
    </section>

    <section class="section band-soft">
      <div class="container-tool max-w-4xl">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <p class="eyebrow">Type mapping</p>
          <h2 class="h-section mt-3">YAML to JSON data types</h2>
        </div>
        <div class="overflow-x-auto tool-card">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-zinc-50 text-left text-zinc-500">
                <th class="px-4 py-3 font-semibold">YAML type</th>
                <th class="px-4 py-3 font-semibold">YAML example</th>
                <th class="px-4 py-3 font-semibold">JSON type</th>
                <th class="px-4 py-3 font-semibold">JSON result</th>
              </tr>
            </thead>
            <tbody class="font-mono text-[13px]">
              <tr class="border-t border-zinc-100"><td class="px-4 py-2.5 font-sans text-zinc-700">String</td><td>hello</td><td class="font-sans text-zinc-700">String</td><td>"hello"</td></tr>
              <tr class="border-t border-zinc-100"><td class="px-4 py-2.5 font-sans text-zinc-700">Integer</td><td>42</td><td class="font-sans text-zinc-700">Number</td><td>42</td></tr>
              <tr class="border-t border-zinc-100"><td class="px-4 py-2.5 font-sans text-zinc-700">Float</td><td>3.14</td><td class="font-sans text-zinc-700">Number</td><td>3.14</td></tr>
              <tr class="border-t border-zinc-100"><td class="px-4 py-2.5 font-sans text-zinc-700">Boolean</td><td>true</td><td class="font-sans text-zinc-700">Boolean</td><td>true</td></tr>
              <tr class="border-t border-zinc-100"><td class="px-4 py-2.5 font-sans text-zinc-700">Null</td><td>null / ~</td><td class="font-sans text-zinc-700">Null</td><td>null</td></tr>
              <tr class="border-t border-zinc-100"><td class="px-4 py-2.5 font-sans text-zinc-700">Date</td><td>2025-01-15</td><td class="font-sans text-zinc-700">String</td><td>"2025-01-15"</td></tr>
              <tr class="border-t border-zinc-100"><td class="px-4 py-2.5 font-sans text-zinc-700">Sequence</td><td>- a<br>- b</td><td class="font-sans text-zinc-700">Array</td><td>["a", "b"]</td></tr>
              <tr class="border-t border-zinc-100"><td class="px-4 py-2.5 font-sans text-zinc-700">Mapping</td><td>key: val</td><td class="font-sans text-zinc-700">Object</td><td>{'{'}"key": "val"{'}'}</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="container-tool section">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <p class="eyebrow">Real-world examples</p>
        <h2 class="h-section mt-3">DevOps configs, converted</h2>
        <p class="lead mt-4">Common configuration files, before and after conversion.</p>
      </div>
      <div class="space-y-10">
        <div>
          <h3 class="h-sub mb-4">Kubernetes Deployment</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <figure class="tool-card">
              <figcaption class="px-4 py-2.5 border-b border-zinc-200 bg-zinc-50 text-sm font-medium text-zinc-700">YAML</figcaption>
              <pre class="p-5 text-[13px] leading-relaxed overflow-x-auto" set:html={k8sYaml}></pre>
            </figure>
            <figure class="tool-card">
              <figcaption class="px-4 py-2.5 border-b border-zinc-200 bg-zinc-50 text-sm font-medium text-zinc-700">JSON</figcaption>
              <pre class="p-5 text-[13px] leading-relaxed overflow-x-auto" set:html={k8sJson}></pre>
            </figure>
          </div>
        </div>
        <div>
          <h3 class="h-sub mb-4">Docker Compose</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <figure class="tool-card">
              <figcaption class="px-4 py-2.5 border-b border-zinc-200 bg-zinc-50 text-sm font-medium text-zinc-700">YAML</figcaption>
              <pre class="p-5 text-[13px] leading-relaxed overflow-x-auto" set:html={dockerYaml}></pre>
            </figure>
            <figure class="tool-card">
              <figcaption class="px-4 py-2.5 border-b border-zinc-200 bg-zinc-50 text-sm font-medium text-zinc-700">JSON</figcaption>
              <pre class="p-5 text-[13px] leading-relaxed overflow-x-auto" set:html={dockerJson}></pre>
            </figure>
          </div>
        </div>
        <div>
          <h3 class="h-sub mb-4">GitHub Actions workflow</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <figure class="tool-card">
              <figcaption class="px-4 py-2.5 border-b border-zinc-200 bg-zinc-50 text-sm font-medium text-zinc-700">YAML</figcaption>
              <pre class="p-5 text-[13px] leading-relaxed overflow-x-auto" set:html={ciYaml}></pre>
            </figure>
            <figure class="tool-card">
              <figcaption class="px-4 py-2.5 border-b border-zinc-200 bg-zinc-50 text-sm font-medium text-zinc-700">JSON</figcaption>
              <pre class="p-5 text-[13px] leading-relaxed overflow-x-auto" set:html={ciJson}></pre>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section class="section band-soft">
      <div class="container-tool max-w-3xl">
        <h2 class="h-section text-center mb-10">Frequently asked questions</h2>
        <dl class="space-y-3">
          <div class="border border-zinc-200 rounded-xl overflow-hidden bg-white">
            <dt><button type="button" class="faq-toggle flex w-full items-center justify-between gap-3 px-5 py-4 text-left text-sm font-medium text-zinc-900 hover:bg-zinc-50" aria-expanded="false"><span>Is the conversion accurate?</span><svg class="faq-chevron w-4 h-4 text-zinc-400 shrink-0 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button></dt>
            <dd class="faq-answer hidden px-5 pb-4 text-sm text-zinc-600 leading-relaxed">Yes. The <code class="text-xs">yaml</code> library follows the YAML 1.2 specification, so data types, nesting, and values are preserved exactly — the conversion is lossless.</dd>
          </div>
          <div class="border border-zinc-200 rounded-xl overflow-hidden bg-white">
            <dt><button type="button" class="faq-toggle flex w-full items-center justify-between gap-3 px-5 py-4 text-left text-sm font-medium text-zinc-900 hover:bg-zinc-50" aria-expanded="false"><span>Does this tool send my data anywhere?</span><svg class="faq-chevron w-4 h-4 text-zinc-400 shrink-0 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button></dt>
            <dd class="faq-answer hidden px-5 pb-4 text-sm text-zinc-600 leading-relaxed">No. Everything runs in your browser with client-side JavaScript. Disconnect from the internet after loading and conversion still works.</dd>
          </div>
          <div class="border border-zinc-200 rounded-xl overflow-hidden bg-white">
            <dt><button type="button" class="faq-toggle flex w-full items-center justify-between gap-3 px-5 py-4 text-left text-sm font-medium text-zinc-900 hover:bg-zinc-50" aria-expanded="false"><span>What happens to anchors and comments?</span><svg class="faq-chevron w-4 h-4 text-zinc-400 shrink-0 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button></dt>
            <dd class="faq-answer hidden px-5 pb-4 text-sm text-zinc-600 leading-relaxed">Anchors and aliases are resolved into their real values. Comments are dropped — JSON has no comment syntax, so the output stays valid.</dd>
          </div>
          <div class="border border-zinc-200 rounded-xl overflow-hidden bg-white">
            <dt><button type="button" class="faq-toggle flex w-full items-center justify-between gap-3 px-5 py-4 text-left text-sm font-medium text-zinc-900 hover:bg-zinc-50" aria-expanded="false"><span>Can I convert large files?</span><svg class="faq-chevron w-4 h-4 text-zinc-400 shrink-0 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button></dt>
            <dd class="faq-answer hidden px-5 pb-4 text-sm text-zinc-600 leading-relaxed">Yes — thousands of lines convert in moments, entirely client-side. Drag and drop <code class="text-xs">.yaml</code> / <code class="text-xs">.yml</code> files straight into the editor.</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="container-tool section">
      <h2 class="h-section text-center mb-10">Related tools</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 max-w-4xl mx-auto">
        <a href="/" class="p-6 rounded-2xl border border-zinc-200 bg-white no-underline block hover:bg-zinc-50">
          <h3 class="h-sub">YAML Formatter</h3>
          <p class="mt-2 text-sm text-zinc-500">Format and validate YAML with consistent indentation.</p>
        </a>
        <a href="/json-to-yaml" class="p-6 rounded-2xl border border-zinc-200 bg-white no-underline block hover:bg-zinc-50">
          <h3 class="h-sub">JSON to YAML</h3>
          <p class="mt-2 text-sm text-zinc-500">Convert JSON back to clean, readable YAML.</p>
        </a>
        <a href="/case-converter" class="p-6 rounded-2xl border border-zinc-200 bg-white no-underline block hover:bg-zinc-50">
          <h3 class="h-sub">Case Converter</h3>
          <p class="mt-2 text-sm text-zinc-500">Shift text between seven case styles instantly.</p>
        </a>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    document.querySelectorAll(".faq-toggle").forEach((e) => {
      e.addEventListener("click", () => {
        const answer = e.closest("div")?.querySelector(".faq-answer");
        const chevron = e.querySelector(".faq-chevron");
        const expanded = e.getAttribute("aria-expanded") === "true";
        e.setAttribute("aria-expanded", String(!expanded));
        answer?.classList.toggle("hidden");
        chevron?.classList.toggle("rotate-180");
      });
    });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>