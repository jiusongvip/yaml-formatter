---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolPanel from '../components/ToolPanel';

const DEFAULT_JSON_INPUT = JSON.stringify({name:"my-app",version:"1.0.0",description:"A sample application",settings:{debug:false,port:3000,hosts:["localhost","0.0.0.0"],database:{host:"db.example.com",port:5432,name:"myapp_db"}}}, null, 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'JSON to YAML Converter',
      url: 'https://yaml-formatter.com/json-to-yaml',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      description: 'Free online JSON to YAML converter. Convert JSON to YAML instantly in your browser — no server upload, no registration. Handles nested objects, arrays, and pretty-printed block output.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      browserRequirements: 'Requires JavaScript',
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        { '@type': 'Question', name: 'Is the JSON to YAML conversion accurate?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. We use JSON.parse combined with the yaml stringify library (v2) which follows the YAML 1.2 specification. The conversion is lossless — all data types, nested structures, and values are preserved exactly.' } },
        { '@type': 'Question', name: 'Does this tool send my data to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. All JSON to YAML conversion runs entirely in your browser using client-side JavaScript. Your data never leaves your computer. You can disconnect from the internet and the converter will continue to work.' } },
        { '@type': 'Question', name: 'Can I convert large JSON files?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. The tool handles files with thousands of lines efficiently. For extremely large files (10,000+ lines), conversion may take a moment but remains fully client-side. You can also drag and drop .json files directly into the editor.' } },
        { '@type': 'Question', name: 'Does the output YAML support comments?', acceptedAnswer: { '@type': 'Answer', text: 'The converter produces clean, valid YAML. While JSON does not have comments, the resulting YAML can be manually edited to add comments since YAML supports the # comment syntax.' } },
        { '@type': 'Question', name: 'How are JSON data types mapped to YAML?', acceptedAnswer: { '@type': 'Answer', text: 'JSON strings, numbers, booleans, and null map directly to YAML equivalents. JSON arrays become YAML sequences. JSON objects become YAML mappings. The output uses standard YAML 1.2 formatting.' } },
        { '@type': 'Question', name: 'How does the converter handle ambiguous values?', acceptedAnswer: { '@type': 'Answer', text: 'Strings that look like booleans in YAML 1.1 (yes, no, on, off) or that could be misread as numbers are automatically quoted, so the output always round-trips back to the original JSON value.' } },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://yaml-formatter.com' },
        { '@type': 'ListItem', position: 2, name: 'JSON to YAML Converter' },
      ],
    },
  ],
};

const cmpJson = `{
  "name": "my-app",
  "version": "1.0.0",
  "description": "A sample application",
  "settings": {
    "debug": false,
    "port": 3000,
    "hosts": ["localhost", "0.0.0.0"],
    "database": {
      "host": "db.example.com",
      "port": 5432,
      "name": "myapp_db"
    }
  }
}`;

const cmpYaml = `name: my-app
version: 1.0.0
description: A sample application
settings:
  debug: false
  port: 3000
  hosts:
    - localhost
    - 0.0.0.0
  database:
    host: db.example.com
    port: 5432
    name: myapp_db`;

const k8sJson = `{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "nginx-deployment",
    "labels": { "app": "nginx" }
  },
  "spec": {
    "replicas": 3,
    "selector": {
      "matchLabels": { "app": "nginx" }
    },
    "template": {
      "metadata": {
        "labels": { "app": "nginx" }
      },
      "spec": {
        "containers": [
          {
            "name": "nginx",
            "image": "nginx:1.25",
            "ports": [{ "containerPort": 80 }]
          }
        ]
      }
    }
  }
}`;

const k8sYaml = `apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx-deployment
  labels:
    app: nginx
spec:
  replicas: 3
  selector:
    matchLabels:
      app: nginx
  template:
    metadata:
      labels:
        app: nginx
    spec:
      containers:
      - name: nginx
        image: nginx:1.25
        ports:
        - containerPort: 80`;

const dockerJson = `{
  "version": "3.8",
  "services": {
    "web": {
      "build": ".",
      "ports": ["3000:3000"],
      "environment": { "NODE_ENV": "production" },
      "depends_on": ["db", "redis"]
    },
    "db": {
      "image": "postgres:15",
      "volumes": ["pgdata:/var/lib/postgresql/data"],
      "environment": { "POSTGRES_DB": "myapp" }
    },
    "redis": {
      "image": "redis:7-alpine"
    }
  },
  "volumes": { "pgdata": null }
}`;

const dockerYaml = `version: "3.8"
services:
  web:
    build: .
    ports:
      - "3000:3000"
    environment:
      NODE_ENV: production
    depends_on:
      - db
      - redis
  db:
    image: postgres:15
    volumes:
      - pgdata:/var/lib/postgresql/data
    environment:
      POSTGRES_DB: myapp
  redis:
    image: redis:7-alpine
volumes:
  pgdata:`;
---

<BaseLayout
  title="JSON to YAML Converter - Free Online JSON to YAML Tool"
  description="Convert JSON to YAML instantly in your browser. Free online converter with zero server upload. Supports nested objects, arrays, and pretty-printed block YAML."
>
  <Header />

  <main>
    <section class="container-tool pt-16 md:pt-20 pb-6 text-center">
      <nav class="flex items-center justify-center gap-2 text-sm text-zinc-400 mb-6">
        <a href="/" class="text-zinc-500 hover:text-zinc-900">Home</a>
        <span>/</span>
        <span class="text-zinc-700">JSON to YAML Converter</span>
      </nav>
      <h1 class="display">JSON to YAML</h1>
      <p class="lead mt-6 max-w-2xl mx-auto">
        Convert JSON to YAML instantly in your browser. No upload, no server —
        the conversion runs entirely on your device.
      </p>
      <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-zinc-200 bg-zinc-50 text-sm text-zinc-600 mt-6">
        <svg class="w-4 h-4 text-blue-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Your data never leaves your browser.
      </span>
    </section>

    <ToolPanel client:idle initialTab="json-to-yaml" initialInput={DEFAULT_JSON_INPUT} />

    <section class="container-tool section">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <p class="eyebrow">Side by side</p>
        <h2 class="h-section mt-3">JSON vs YAML</h2>
        <p class="lead mt-4">The same structure in both formats. JSON relies on quotes, braces, and commas; YAML uses indentation and reads like a plain outline.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <figure class="tool-card">
          <figcaption class="px-4 py-2.5 border-b border-zinc-200 bg-zinc-50 text-sm font-medium text-zinc-700">JSON input</figcaption>
          <pre class="p-5 text-[13px] leading-relaxed overflow-x-auto" set:html={cmpJson}></pre>
        </figure>
        <figure class="tool-card">
          <figcaption class="px-4 py-2.5 border-b border-zinc-200 bg-zinc-50 text-sm font-medium text-zinc-700">YAML output</figcaption>
          <pre class="p-5 text-[13px] leading-relaxed overflow-x-auto" set:html={cmpYaml}></pre>
        </figure>
      </div>
    </section>

    <section class="section band-soft">
      <div class="container-tool">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <p class="eyebrow">Why this converter</p>
          <h2 class="h-section mt-3">Clean, spec-compliant YAML</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
            <h3 class="h-sub">YAML 1.2 output</h3>
            <p class="mt-2 text-zinc-500 leading-relaxed">Output follows the YAML 1.2 spec with correct type detection and consistent 2-space indentation — ready for k8s, Docker, and CI files.</p>
          </div>
          <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
            <h3 class="h-sub">Modern block style</h3>
            <p class="mt-2 text-zinc-500 leading-relaxed">Configuration is emitted in readable block style with flow only where it fits — arrays of scalars and small inline maps.</p>
          </div>
          <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
            <h3 class="h-sub">Ambiguity-safe quoting</h3>
            <p class="mt-2 text-zinc-500 leading-relaxed">Strings like <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-100">"yes"</code>, <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-100">"on"</code>, or <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-100">"8080"</code> are quoted so they round-trip back to the exact JSON string.</p>
          </div>
          <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
            <h3 class="h-sub">Strict JSON validation</h3>
            <p class="mt-2 text-zinc-500 leading-relaxed">Bad JSON is caught with the precise line and column, plus a plain-language hint — no silent mangling of your data.</p>
          </div>
          <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
            <h3 class="h-sub">Deep nesting kept</h3>
            <p class="mt-2 text-zinc-500 leading-relaxed">Nested objects and arrays of any depth are preserved exactly. Keys with special characters are quoted automatically.</p>
          </div>
          <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
            <h3 class="h-sub">Private by default</h3>
            <p class="mt-2 text-zinc-500 leading-relaxed">Everything runs client-side. There is no backend, so there is nowhere for your data to go — it works even offline.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="container-tool section">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <p class="eyebrow">Use cases</p>
        <h2 class="h-section mt-3">Why convert JSON to YAML?</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-4xl mx-auto">
        <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
          <h3 class="h-sub">Kubernetes manifests</h3>
          <p class="mt-2 text-zinc-500 leading-relaxed">Kubernetes expects YAML. Turn JSON-generated configs or exported values into manifests for <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-100">kubectl apply</code>.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
          <h3 class="h-sub">Docker Compose</h3>
          <p class="mt-2 text-zinc-500 leading-relaxed">Compose files are written in YAML. Convert JSON service definitions into a <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-100">docker-compose.yml</code> you can commit.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
          <h3 class="h-sub">CI/CD workflows</h3>
          <p class="mt-2 text-zinc-500 leading-relaxed">GitHub Actions, GitLab CI, and CircleCI all read YAML. Convert JSON pipeline definitions for your repo.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200 bg-white">
          <h3 class="h-sub">Ansible playbooks</h3>
          <p class="mt-2 text-zinc-500 leading-relaxed">Playbooks, roles, and inventories live in YAML. Turn JSON task definitions into automation-ready files.</p>
        </div>
      </div>
    </section>

    <section class="section band-soft">
      <div class="container-tool max-w-4xl">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <p class="eyebrow">Type mapping</p>
          <h2 class="h-section mt-3">JSON to YAML data types</h2>
        </div>
        <div class="overflow-x-auto tool-card">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-zinc-50 text-left text-zinc-500">
                <th class="px-4 py-3 font-semibold">JSON type</th>
                <th class="px-4 py-3 font-semibold">JSON example</th>
                <th class="px-4 py-3 font-semibold">YAML type</th>
                <th class="px-4 py-3 font-semibold">YAML result</th>
              </tr>
            </thead>
            <tbody class="font-mono text-[13px]">
              <tr class="border-t border-zinc-100"><td class="px-4 py-2.5 font-sans text-zinc-700">String</td><td>"hello"</td><td class="font-sans text-zinc-700">String</td><td>hello</td></tr>
              <tr class="border-t border-zinc-100"><td class="px-4 py-2.5 font-sans text-zinc-700">Integer</td><td>42</td><td class="font-sans text-zinc-700">Integer</td><td>42</td></tr>
              <tr class="border-t border-zinc-100"><td class="px-4 py-2.5 font-sans text-zinc-700">Float</td><td>3.14</td><td class="font-sans text-zinc-700">Float</td><td>3.14</td></tr>
              <tr class="border-t border-zinc-100"><td class="px-4 py-2.5 font-sans text-zinc-700">Boolean</td><td>true</td><td class="font-sans text-zinc-700">Boolean</td><td>true</td></tr>
              <tr class="border-t border-zinc-100"><td class="px-4 py-2.5 font-sans text-zinc-700">Null</td><td>null</td><td class="font-sans text-zinc-700">Null</td><td>null</td></tr>
              <tr class="border-t border-zinc-100"><td class="px-4 py-2.5 font-sans text-zinc-700">Array</td><td>["a", "b"]</td><td class="font-sans text-zinc-700">Sequence</td><td>- a<br>- b</td></tr>
              <tr class="border-t border-zinc-100"><td class="px-4 py-2.5 font-sans text-zinc-700">Object</td><td>{'{'}"key": "value"{'}'}</td><td class="font-sans text-zinc-700">Mapping</td><td>key: value</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="container-tool section">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <p class="eyebrow">Real-world examples</p>
        <h2 class="h-section mt-3">Configs, converted</h2>
        <p class="lead mt-4">Real configuration files, before and after conversion.</p>
      </div>
      <div class="space-y-10">
        <div>
          <h3 class="h-sub mb-4">Kubernetes Deployment</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <figure class="tool-card">
              <figcaption class="px-4 py-2.5 border-b border-zinc-200 bg-zinc-50 text-sm font-medium text-zinc-700">JSON</figcaption>
              <pre class="p-5 text-[13px] leading-relaxed overflow-x-auto" set:html={k8sJson}></pre>
            </figure>
            <figure class="tool-card">
              <figcaption class="px-4 py-2.5 border-b border-zinc-200 bg-zinc-50 text-sm font-medium text-zinc-700">YAML</figcaption>
              <pre class="p-5 text-[13px] leading-relaxed overflow-x-auto" set:html={k8sYaml}></pre>
            </figure>
          </div>
        </div>
        <div>
          <h3 class="h-sub mb-4">Docker Compose</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <figure class="tool-card">
              <figcaption class="px-4 py-2.5 border-b border-zinc-200 bg-zinc-50 text-sm font-medium text-zinc-700">JSON</figcaption>
              <pre class="p-5 text-[13px] leading-relaxed overflow-x-auto" set:html={dockerJson}></pre>
            </figure>
            <figure class="tool-card">
              <figcaption class="px-4 py-2.5 border-b border-zinc-200 bg-zinc-50 text-sm font-medium text-zinc-700">YAML</figcaption>
              <pre class="p-5 text-[13px] leading-relaxed overflow-x-auto" set:html={dockerYaml}></pre>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section class="section band-soft">
      <div class="container-tool max-w-3xl">
        <h2 class="h-section text-center mb-10">Frequently asked questions</h2>
        <dl class="space-y-3">
          <div class="border border-zinc-200 rounded-xl overflow-hidden bg-white">
            <dt><button type="button" class="faq-toggle flex w-full items-center justify-between gap-3 px-5 py-4 text-left text-sm font-medium text-zinc-900 hover:bg-zinc-50" aria-expanded="false"><span>Is the conversion accurate?</span><svg class="faq-chevron w-4 h-4 text-zinc-400 shrink-0 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button></dt>
            <dd class="faq-answer hidden px-5 pb-4 text-sm text-zinc-600 leading-relaxed">Yes. <code class="text-xs">JSON.parse</code> plus the <code class="text-xs">yaml</code> library (v2) follows YAML 1.2, so data types, nesting, and values are preserved exactly — the conversion is lossless.</dd>
          </div>
          <div class="border border-zinc-200 rounded-xl overflow-hidden bg-white">
            <dt><button type="button" class="faq-toggle flex w-full items-center justify-between gap-3 px-5 py-4 text-left text-sm font-medium text-zinc-900 hover:bg-zinc-50" aria-expanded="false"><span>Does this tool send my data anywhere?</span><svg class="faq-chevron w-4 h-4 text-zinc-400 shrink-0 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button></dt>
            <dd class="faq-answer hidden px-5 pb-4 text-sm text-zinc-600 leading-relaxed">No. Everything runs in your browser with client-side JavaScript. Disconnect from the internet after loading and conversion still works.</dd>
          </div>
          <div class="border border-zinc-200 rounded-xl overflow-hidden bg-white">
            <dt><button type="button" class="faq-toggle flex w-full items-center justify-between gap-3 px-5 py-4 text-left text-sm font-medium text-zinc-900 hover:bg-zinc-50" aria-expanded="false"><span>Why do some strings come out quoted?</span><svg class="faq-chevron w-4 h-4 text-zinc-400 shrink-0 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button></dt>
            <dd class="faq-answer hidden px-5 pb-4 text-sm text-zinc-600 leading-relaxed">Values that look like booleans in older YAML dialects — <code class="text-xs">yes</code>, <code class="text-xs">no</code>, <code class="text-xs">on</code>, <code class="text-xs">off</code> — or that read as numbers are quoted so the YAML parses back to the original string. It keeps round-trips exact.</dd>
          </div>
          <div class="border border-zinc-200 rounded-xl overflow-hidden bg-white">
            <dt><button type="button" class="faq-toggle flex w-full items-center justify-between gap-3 px-5 py-4 text-left text-sm font-medium text-zinc-900 hover:bg-zinc-50" aria-expanded="false"><span>Can I convert large files?</span><svg class="faq-chevron w-4 h-4 text-zinc-400 shrink-0 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button></dt>
            <dd class="faq-answer hidden px-5 pb-4 text-sm text-zinc-600 leading-relaxed">Yes — thousands of lines convert in moments, entirely client-side. Drag and drop <code class="text-xs">.json</code> files straight into the editor.</dd>
          </div>
          <div class="border border-zinc-200 rounded-xl overflow-hidden bg-white">
            <dt><button type="button" class="faq-toggle flex w-full items-center justify-between gap-3 px-5 py-4 text-left text-sm font-medium text-zinc-900 hover:bg-zinc-50" aria-expanded="false"><span>Can the YAML keep comments I add?</span><svg class="faq-chevron w-4 h-4 text-zinc-400 shrink-0 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button></dt>
            <dd class="faq-answer hidden px-5 pb-4 text-sm text-zinc-600 leading-relaxed">JSON has no comment syntax, so nothing to preserve on the way in. But since YAML supports <code class="text-xs">#</code> comments, you can annotate the output before you commit it.</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="container-tool section">
      <h2 class="h-section text-center mb-10">Related tools</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 max-w-4xl mx-auto">
        <a href="/" class="p-6 rounded-2xl border border-zinc-200 bg-white no-underline block hover:bg-zinc-50">
          <h3 class="h-sub">YAML Formatter</h3>
          <p class="mt-2 text-sm text-zinc-500">Format and validate YAML with consistent indentation.</p>
        </a>
        <a href="/yaml-to-json" class="p-6 rounded-2xl border border-zinc-200 bg-white no-underline block hover:bg-zinc-50">
          <h3 class="h-sub">YAML to JSON</h3>
          <p class="mt-2 text-sm text-zinc-500">Convert YAML back to properly formatted JSON.</p>
        </a>
        <a href="/case-converter" class="p-6 rounded-2xl border border-zinc-200 bg-white no-underline block hover:bg-zinc-50">
          <h3 class="h-sub">Case Converter</h3>
          <p class="mt-2 text-sm text-zinc-500">Shift text between seven case styles instantly.</p>
        </a>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    document.querySelectorAll(".faq-toggle").forEach((e) => {
      e.addEventListener("click", () => {
        const answer = e.closest("div")?.querySelector(".faq-answer");
        const chevron = e.querySelector(".faq-chevron");
        const expanded = e.getAttribute("aria-expanded") === "true";
        e.setAttribute("aria-expanded", String(!expanded));
        answer?.classList.toggle("hidden");
        chevron?.classList.toggle("rotate-180");
      });
    });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>