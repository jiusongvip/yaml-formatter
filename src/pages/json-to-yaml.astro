---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPanel from '../components/ToolPanel';

const DEFAULT_JSON_INPUT = JSON.stringify({name:"my-app",version:"1.0.0",description:"A sample application",settings:{debug:false,port:3000,hosts:["localhost","0.0.0.0"],database:{host:"db.example.com",port:5432,name:"myapp_db"}}}, null, 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'JSON to YAML Converter',
      url: 'https://yaml-formatter.com/json-to-yaml',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      description: 'Free online JSON to YAML converter. Convert JSON to YAML instantly in your browser — no server upload, no registration. Handles nested objects, arrays, anchors, and multi-document YAML.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      browserRequirements: 'Requires JavaScript',
    },
    {
      '@type': 'HowTo',
      name: 'How to Convert JSON to YAML',
      step: [
        { '@type': 'HowToStep', position: 1, name: 'Paste or Upload JSON', text: 'Paste your JSON content or drag and drop a .json file into the editor.' },
        { '@type': 'HowToStep', position: 2, name: 'Click the JSON to YAML tab', text: 'The conversion happens instantly in your browser using the JSON.parse + yaml stringify parser. All data stays local.' },
        { '@type': 'HowToStep', position: 3, name: 'Copy the YAML', text: 'Copy the clean YAML output and use it in your Kubernetes manifests, Docker Compose, CI/CD pipelines, or configuration files.' },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        { '@type': 'Question', name: 'Is the JSON to YAML conversion accurate?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. We use JSON.parse combined with the yaml stringify library (v2) which follows the YAML 1.2 specification. The conversion is lossless — all data types, nested structures, and values are preserved exactly.' } },
        { '@type': 'Question', name: 'Does this tool send my data to a server?', acceptedAnswer: { '@type': 'Answer', text: 'No. All JSON to YAML conversion runs entirely in your browser using client-side JavaScript. Your data never leaves your computer. You can disconnect from the internet and the converter will continue to work.' } },
        { '@type': 'Question', name: 'Can I convert large JSON files?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. The tool handles files with thousands of lines efficiently. For extremely large files (10,000+ lines), conversion may take a moment but remains fully client-side. You can also drag and drop .json files directly into the editor.' } },
        { '@type': 'Question', name: 'Does the output YAML support comments?', acceptedAnswer: { '@type': 'Answer', text: 'The converter produces clean, valid YAML. While JSON does not have comments, the resulting YAML can be manually edited to add comments since YAML supports the # comment syntax.' } },
        { '@type': 'Question', name: 'How are JSON data types mapped to YAML?', acceptedAnswer: { '@type': 'Answer', text: 'JSON strings, numbers, booleans, and null map directly to YAML equivalents. JSON arrays become YAML sequences. JSON objects become YAML mappings. The output uses standard YAML 1.2 formatting.' } },
        { '@type': 'Question', name: 'Can I customize the YAML output indentation?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Use the Format tab to adjust indentation (2, 4, or 8 spaces), sort keys alphabetically, and apply other formatting options to your YAML output.' } },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://yaml-formatter.com' },
        { '@type': 'ListItem', position: 2, name: 'JSON to YAML Converter' },
      ],
    },
  ],
};
---

<BaseLayout
  title="JSON to YAML Converter - Free Online JSON to YAML Tool"
  description="Convert JSON to YAML instantly in your browser. Free online converter with zero server upload. Supports nested objects, arrays, and multi-document YAML."
>
  <header class="sticky top-0 z-50 border-b border-zinc-200/60 dark:border-zinc-800/60 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md">
    <nav class="max-w-7xl mx-auto flex items-center justify-between h-14 px-4 sm:px-6 lg:px-8">
      <a href="/" class="flex items-center gap-2.5 group">
        <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-emerald-600 text-white font-bold text-sm group-hover:bg-emerald-700 transition-colors">Y</span>
        <span class="font-semibold text-base tracking-tight text-zinc-900 dark:text-zinc-100">YAML Formatter</span>
      </a>
      <div class="flex items-center gap-4">
        <a href="/" class="text-sm text-zinc-500 dark:text-zinc-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Formatter</a>
        <a href="/blog/yaml-syntax-guide" class="text-sm text-zinc-500 dark:text-zinc-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Blog</a>
        <button id="theme-toggle" class="p-2 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100" aria-label="Toggle theme">
          <svg id="sun-icon" class="w-4 h-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg id="moon-icon" class="w-4 h-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </div>
    </nav>
  </header>
  <script>
    const btn = document.getElementById('theme-toggle');
    btn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  </script>

  <main>
    <section class="pt-20 pb-6 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center">
      <nav class="flex items-center justify-center gap-2 text-sm text-zinc-400 dark:text-zinc-500 mb-4">
        <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a>
        <span>/</span>
        <span class="text-zinc-600 dark:text-zinc-300">JSON to YAML Converter</span>
      </nav>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tighter text-zinc-900 dark:text-zinc-50">JSON to YAML Converter</h1>
      <p class="mt-4 text-lg sm:text-xl text-zinc-500 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed">Convert JSON to YAML <span class="text-zinc-700 dark:text-zinc-300 font-medium">instantly</span> in your browser. No upload, no server.</p>
      <div class="mt-6 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800 text-sm text-emerald-700 dark:text-emerald-300 font-medium">
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Your data never leaves your browser. 100% client-side.
      </div>
    </section>

    <ToolPanel client:idle initialTab="json-to-yaml" initialInput={DEFAULT_JSON_INPUT} />

    <!-- Code Comparison -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-3 text-center">JSON to YAML: Side-by-Side Comparison</h2>
      <p class="text-center text-zinc-500 dark:text-zinc-400 mb-8 max-w-2xl mx-auto">See how the same data structure looks in JSON versus YAML. Notice how YAML eliminates quotes, braces, and commas for a cleaner, more readable format.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 overflow-hidden">
          <div class="px-4 py-2 bg-zinc-100 dark:bg-zinc-800 border-b border-zinc-200 dark:border-zinc-700 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
            <span class="text-xs font-semibold text-zinc-600 dark:text-zinc-300">JSON Input</span>
          </div>
          <pre id="cmp-json" class="p-4 text-sm font-mono"></pre>
        </div>
        <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 overflow-hidden">
          <div class="px-4 py-2 bg-zinc-100 dark:bg-zinc-800 border-b border-zinc-200 dark:border-zinc-700 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            <span class="text-xs font-semibold text-zinc-600 dark:text-zinc-300">YAML Output</span>
          </div>
          <pre id="cmp-yaml" class="p-4 text-sm font-mono"></pre>
        </div>
      </div>
    </section>

    <!-- Key Features -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-8 text-center">Key Features</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <div class="p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <div class="w-9 h-9 rounded-lg bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13 2 13 9 20 9"/></svg>
          </div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1.5">YAML 1.2 Output</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Generates clean, spec-compliant YAML 1.2 output with proper type detection and consistent 2-space indentation.</p>
        </div>
        <div class="p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <div class="w-9 h-9 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
          </div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1.5">100% Client-Side</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">All conversion runs in your browser. Your JSON data is never uploaded to any server. Works offline after page load.</p>
        </div>
        <div class="p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <div class="w-9 h-9 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-purple-600 dark:text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1.5">Smart Type Detection</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Automatically detects numbers, booleans, and null values. Strings that look like numbers are properly quoted in YAML output.</p>
        </div>
        <div class="p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <div class="w-9 h-9 rounded-lg bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
          </div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1.5">Copy &amp; Share</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">One-click copy to clipboard. Generate a shareable URL with your YAML output encoded in the link for team collaboration.</p>
        </div>
        <div class="p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <div class="w-9 h-9 rounded-lg bg-red-100 dark:bg-red-900/30 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-red-600 dark:text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1.5">JSON Validation</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Invalid JSON is caught instantly with precise error messages. Get line and column numbers plus actionable hints to fix issues.</p>
        </div>
        <div class="p-5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <div class="w-9 h-9 rounded-lg bg-cyan-100 dark:bg-cyan-900/30 flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-cyan-600 dark:text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          </div>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-1.5">File Drag &amp; Drop</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Drag and drop <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">.json</code> files directly into the editor for instant conversion to YAML.</p>
        </div>
      </div>
    </section>

    <!-- Why Convert JSON to YAML -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-3 text-center">Why Convert JSON to YAML?</h2>
      <p class="text-center text-zinc-500 dark:text-zinc-400 mb-8 max-w-2xl mx-auto">JSON is great for APIs and data exchange, but YAML is often preferred for configuration files and human-edited documents. Here's when you need to convert.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-2">Kubernetes Manifests</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Kubernetes uses YAML for resource definitions. Convert your JSON-generated configs or Helm chart values to YAML for <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">kubectl apply</code>.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-2">Docker Compose Files</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Docker Compose expects <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">docker-compose.yml</code>. Convert JSON service definitions to YAML format for container orchestration.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-2">CI/CD Pipelines</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">GitHub Actions, GitLab CI, and CircleCI all use YAML workflow files. Convert JSON pipeline definitions for your version control system.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-2">Ansible Playbooks</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">Ansible tasks, roles, and inventories are written in YAML. Convert JSON task definitions for configuration management automation.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-2">More Readable Configs</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">YAML is significantly more readable than JSON — no quotes, no braces, no commas. Convert JSON to YAML for configuration files that humans need to read and edit.</p>
        </div>
        <div class="p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 mb-2">Add Comments</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">JSON doesn't support comments. Convert to YAML first, then add documentation comments to explain complex configuration values for your team.</p>
        </div>
      </div>
    </section>

    <!-- JSON vs YAML Table -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-8 text-center">JSON vs YAML: When to Use Each</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border border-zinc-200 dark:border-zinc-800 rounded-xl overflow-hidden">
          <thead>
            <tr class="bg-zinc-50 dark:bg-zinc-900">
              <th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300 border-b border-zinc-200 dark:border-zinc-800">Aspect</th>
              <th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300 border-b border-zinc-200 dark:border-zinc-800">JSON</th>
              <th class="px-4 py-3 text-left font-semibold text-zinc-700 dark:text-zinc-300 border-b border-zinc-200 dark:border-zinc-800">YAML</th>
            </tr>
          </thead>
          <tbody class="text-zinc-600 dark:text-zinc-400">
            <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-medium text-zinc-800 dark:text-zinc-200">Best For</td><td class="px-4 py-2.5">APIs, data exchange, machine-to-machine</td><td class="px-4 py-2.5">Configuration files, human-edited documents</td></tr>
            <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-medium text-zinc-800 dark:text-zinc-200">Readability</td><td class="px-4 py-2.5">Verbose (quotes, braces, commas)</td><td class="px-4 py-2.5">Clean (indentation-based, minimal syntax)</td></tr>
            <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-medium text-zinc-800 dark:text-zinc-200">Comments</td><td class="px-4 py-2.5">Not supported</td><td class="px-4 py-2.5">Supported (<code class="text-xs">#</code>)</td></tr>
            <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-medium text-zinc-800 dark:text-zinc-200">File Size</td><td class="px-4 py-2.5">Larger (more syntax overhead)</td><td class="px-4 py-2.5">Smaller (compact representation)</td></tr>
            <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-medium text-zinc-800 dark:text-zinc-200">Parsing Speed</td><td class="px-4 py-2.5">Fast (native browser support)</td><td class="px-4 py-2.5">Slower (complex specification)</td></tr>
            <tr class="border-b border-zinc-100 dark:border-zinc-800/50"><td class="px-4 py-2.5 font-medium text-zinc-800 dark:text-zinc-200">Error Diagnosis</td><td class="px-4 py-2.5">Strict, clear error messages</td><td class="px-4 py-2.5">Indentation errors can be subtle</td></tr>
            <tr><td class="px-4 py-2.5 font-medium text-zinc-800 dark:text-zinc-200">Used By</td><td class="px-4 py-2.5">REST APIs, NoSQL DBs, config files</td><td class="px-4 py-2.5">K8s, Docker, Ansible, GitHub Actions</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- How It Works -->
    <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50 mb-3 text-center">How to Convert JSON to YAML</h2>
      <p class="text-center text-zinc-500 dark:text-zinc-400 mb-10 max-w-2xl mx-auto">Three simple steps to transform your JSON data into clean, readable YAML — all processed locally in your browser.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 font-bold text-lg mb-4">1</span>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 text-lg mb-2">Paste Your JSON</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">Paste your JSON into the editor — from an API response, a <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">package.json</code>, or a NoSQL export. You can also drag and drop <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">.json</code> files directly.</p>
        </div>
        <div class="text-center">
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-300 font-bold text-lg mb-4">2</span>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 text-lg mb-2">Click JSON to YAML</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">Switch to the "JSON to YAML" tab. The conversion uses <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">JSON.parse</code> combined with the <code class="text-xs px-1 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800">yaml</code> stringify library for spec-compliant output.</p>
        </div>
        <div class="text-center">
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-300 font-bold text-lg mb-4">3</span>
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 text-lg mb-2">Copy the YAML</h3>
